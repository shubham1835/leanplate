# ─────────────────────────────────────────────────────────────────
# .env.local — local development overrides (never commit this file)
# ─────────────────────────────────────────────────────────────────

# Set to true to use mock data (no backend needed)
# Set to false to hit the real Spring Boot API
VITE_USE_MOCK=false

# API base URL (only used when VITE_USE_MOCK=false)
VITE_API_URL=http://192.168.1.2:8080/api/v1
# VITE_API_URL=https://fit-fuel-1-0-0.onrender.com/api/v1
